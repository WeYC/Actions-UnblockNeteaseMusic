+'use strict';
+
+/*
+ * 启动配置：exe 同目录找不到 config.ini 就就地生成一份默认的，
+ * 找到就按 [source] order（-o 默认值，命令行优先）、[cookie]/[env]（缺失的环境变量才补）加载。
+ * 配置缺失或损坏时静默回退默认行为，不影响启动。
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+const FILE_NAME = 'config.ini';
+const COOKIE_KEYS = {
+	qq: 'QQ_COOKIE',
+	migu: 'MIGU_COOKIE',
+	joox: 'JOOX_COOKIE',
+};
+const ENV_KEYS = new Set([
+	'ENABLE_FLAC',
+	'ENABLE_LOCAL_VIP',
+	'LOCAL_VIP_UID',
+	'ENABLE_HTTPDNS',
+	'BLOCK_ADS',
+	'DISABLE_UPGRADE_CHECK',
+	'DEVELOPMENT',
+	'FOLLOW_SOURCE_ORDER',
+	'JSON_LOG',
+	'NO_CACHE',
+	'MIN_BR',
+	'SELECT_MAX_BR',
+	'LOG_LEVEL',
+	'LOG_FILE',
+	'JOOX_COOKIE',
+	'MIGU_COOKIE',
+	'QQ_COOKIE',
+	'YOUTUBE_KEY',
+	'SIGN_CERT',
+	'SIGN_KEY',
+	'SEARCH_ALBUM',
+	'NETEASE_COOKIE',
+]);
+
+const DEFAULT_CONFIG = [
+	'[source]',
+	'order = kugou bodian kuwo bilibili bilivideo',
+	'',
+	'[cookie]',
+	'qq =',
+	'migu =',
+	'joox =',
+	'',
+	'[env]',
+	'ENABLE_FLAC =',
+	'ENABLE_LOCAL_VIP =',
+	'LOCAL_VIP_UID =',
+	'ENABLE_HTTPDNS =',
+	'BLOCK_ADS =',
+	'DISABLE_UPGRADE_CHECK =',
+	'DEVELOPMENT =',
+	'FOLLOW_SOURCE_ORDER =',
+	'JSON_LOG =',
+	'NO_CACHE =',
+	'MIN_BR =',
+	'SELECT_MAX_BR =',
+	'LOG_LEVEL =',
+	'LOG_FILE =',
+	'JOOX_COOKIE =',
+	'MIGU_COOKIE =',
+	'QQ_COOKIE =',
+	'YOUTUBE_KEY =',
+	'SIGN_CERT =',
+	'SIGN_KEY =',
+	'SEARCH_ALBUM =',
+	'NETEASE_COOKIE =',
+	'',
+].join('\r\n');
+
+function candidateDirs() {
+	const dirs = [];
+	try {
+		dirs.push(path.dirname(process.execPath));
+	} catch (e) {}
+	try {
+		dirs.push(process.cwd());
+	} catch (e) {}
+	return [...new Set(dirs)].filter(Boolean);
+}
+
+function cleanValue(raw) {
+	let value = raw.trim();
+	if (!value || value[0] === ';') return '';
+	const quote = value[0];
+	if ((quote === '"' || quote === "'") && value.length > 1) {
+		const end = value.indexOf(quote, 1);
+		return end > 0 ? value.slice(1, end) : value.slice(1);
+	}
+	const cut = value.search(/\s+;/);
+	if (cut >= 0) value = value.slice(0, cut);
+	return value.trim();
+}
+
+function parseIni(text) {
+	const out = { order: [], env: {} };
+	let section = '';
+	for (const raw of text.split(/\r?\n/)) {
+		const line = raw.trim();
+		if (!line || line.startsWith(';') || line.startsWith('#')) continue;
+		const sec = line.match(/^\[(.+)\]$/);
+		if (sec) {
+			section = sec[1].trim().toLowerCase();
+			continue;
+		}
+		const eq = line.indexOf('=');
+		if (eq < 0) continue;
+		const key = line.slice(0, eq).trim().toLowerCase();
+		const value = cleanValue(line.slice(eq + 1));
+		if (!value) continue;
+		if (section === 'source' && key === 'order') {
+			out.order = value.split(/[\s,;]+/).filter(Boolean);
+		} else if (section === 'cookie' && key in COOKIE_KEYS) {
+			out.env[COOKIE_KEYS[key]] = value;
+		} else if (section === 'cookie' && ENV_KEYS.has(key.toUpperCase())) {
+			out.env[key.toUpperCase()] = value;
+		} else if (section === 'env' && ENV_KEYS.has(key.toUpperCase())) {
+			out.env[key.toUpperCase()] = value;
+		}
+	}
+	return out;
+}
+
+function loadStartupConfig() {
+	for (const dir of candidateDirs()) {
+		const file = path.join(dir, FILE_NAME);
+		try {
+			if (fs.statSync(file).isFile()) return parseIni(fs.readFileSync(file, 'utf8'));
+		} catch (e) {}
+	}
+	for (const dir of candidateDirs()) {
+		try {
+			const file = path.join(dir, FILE_NAME);
+			if (!fs.existsSync(file)) fs.writeFileSync(file, DEFAULT_CONFIG);
+			return parseIni(DEFAULT_CONFIG);
+		} catch (e) {}
+	}
+	return { order: [], env: {} };
+}
+
+module.exports = { loadStartupConfig };
