+'use strict';
+
+/*
+ * 启动配置：exe 同目录找不到 config.ini 就就地生成一份默认的，
+ * 找到就按 [source] order（-o 默认值，命令行优先）、[cookie]（缺失的环境变量才补）加载。
+ * 配置缺失或损坏时静默回退默认行为，不影响启动。
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+const FILE_NAME = 'config.ini';
+const COOKIE_KEYS = {
+	qq: 'QQ_COOKIE',
+	migu: 'MIGU_COOKIE',
+	joox: 'JOOX_COOKIE',
+};
+
+const DEFAULT_CONFIG = [
+	'; UnblockNeteaseMusic 配置文件（首次启动自动生成）',
+	'; 放在 exe 同目录下，启动时自动加载；命令行 -o 优先于这里',
+	'',
+	'[source]',
+	'; 音源顺序，默认开启免 cookie 的音源',
+	'order = kugou bodian kuwo bilibili bilivideo',
+	'',
+	'[cookie]',
+	'; 有 cookie 就填等号后面，没有留空',
+	'; QQ 音乐：uin=你的uin; qm_keyst=你的qm_keyst',
+	'qq =',
+	'; 咪咕：你的aversionid',
+	'migu =',
+	'; JOOX：wmid=你的wmid; session_key=你的session_key（仅港澳台泰马印尼）',
+	'joox =',
+	'',
+].join('\r\n');
+
+function candidateDirs() {
+	const dirs = [];
+	try {
+		dirs.push(path.dirname(process.execPath));
+	} catch (e) {}
+	try {
+		dirs.push(process.cwd());
+	} catch (e) {}
+	return [...new Set(dirs)].filter(Boolean);
+}
+
+function unquote(value) {
+	const m = value.match(/^(['"])(.*)\1$/);
+	return m ? m[2] : value;
+}
+
+function parseIni(text) {
+	const out = { order: [], env: {} };
+	let section = '';
+	for (const raw of text.split(/\r?\n/)) {
+		const line = raw.trim();
+		if (!line || line.startsWith(';') || line.startsWith('#')) continue;
+		const sec = line.match(/^\[(.+)\]$/);
+		if (sec) {
+			section = sec[1].trim().toLowerCase();
+			continue;
+		}
+		const eq = line.indexOf('=');
+		if (eq < 0) continue;
+		const key = line.slice(0, eq).trim().toLowerCase();
+		const value = unquote(line.slice(eq + 1).trim());
+		if (!value) continue;
+		if (section === 'source' && key === 'order') {
+			out.order = value.split(/[\s,;]+/).filter(Boolean);
+		} else if (section === 'cookie' && key in COOKIE_KEYS) {
+			out.env[COOKIE_KEYS[key]] = value;
+		} else if (section === 'cookie' && Object.values(COOKIE_KEYS).includes(key.toUpperCase())) {
+			out.env[key.toUpperCase()] = value;
+		}
+	}
+	return out;
+}
+
+function loadStartupConfig() {
+	for (const dir of candidateDirs()) {
+		const file = path.join(dir, FILE_NAME);
+		try {
+			if (fs.statSync(file).isFile()) return parseIni(fs.readFileSync(file, 'utf8'));
+		} catch (e) {}
+	}
+	for (const dir of candidateDirs()) {
+		try {
+			const file = path.join(dir, FILE_NAME);
+			if (!fs.existsSync(file)) fs.writeFileSync(file, DEFAULT_CONFIG);
+			return parseIni(DEFAULT_CONFIG);
+		} catch (e) {}
+	}
+	return { order: [], env: {} };
+}
+
+module.exports = { loadStartupConfig };
